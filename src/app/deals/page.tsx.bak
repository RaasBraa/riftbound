'use client';

import { useState, useEffect } from 'react';
import Link from 'next/link';

interface Deal {
  id: number;
  source: string;
  url: string;
  title: string;
  imageUrl?: string;
  detectedCardId?: string;
  detectedCardName?: string;
  detectedCardCode?: string;
  confidence?: number;
  languageFilterPass: boolean;
  buyPriceSek: number;
  shippingEstimateSek: number;
  cardmarketEnLowSek?: number;
  cardmarketEnAvgSek?: number;
  expectedProfitSek?: number;
  scannedAt: string;
}

export default function DealsPage() {
  const [deals, setDeals] = useState<Deal[]>([]);
  const [loading, setLoading] = useState(true);
  const [scanning, setScanning] = useState(false);

  useEffect(() => {
    loadDeals();
  }, []);

  async function loadDeals() {
    try {
      const res = await fetch('/api/v1/deals');
      if (res.ok) {
        const data = await res.json();
        setDeals(data.deals || []);
      }
    } catch (error) {
      console.error('Failed to load deals:', error);
    } finally {
      setLoading(false);
    }
  }

  async function scanForDeals() {
    setScanning(true);
    try {
      const res = await fetch('/api/v1/deals/scan', { method: 'POST' });
      if (res.ok) {
        await loadDeals();
      }
    } catch (error) {
      console.error('Failed to scan for deals:', error);
    } finally {
      setScanning(false);
    }
  }

  const goodDeals = deals.filter((d) => d.languageFilterPass && d.expectedProfitSek && d.expectedProfitSek > 20);

  return (
    <div className="min-h-screen bg-gray-50">
      <nav className="bg-white shadow-sm border-b">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex justify-between h-16">
            <div className="flex">
              <div className="flex-shrink-0 flex items-center">
                <Link href="/" className="text-xl font-bold text-gray-900">Riftbound Business</Link>
              </div>
              <div className="hidden sm:ml-6 sm:flex sm:space-x-8">
                <Link href="/" className="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">
                  Dashboard
                </Link>
                <Link href="/collection" className="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">
                  Collection
                </Link>
                <Link href="/inventory" className="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">
                  Inventory
                </Link>
                <Link href="/purchases" className="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">
                  Purchases
                </Link>
                <Link href="/deals" className="border-indigo-500 text-gray-900 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">
                  Deals
                </Link>
                <Link href="/sold" className="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">
                  Sold
                </Link>
                <Link href="/settings" className="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">
                  Settings
                </Link>
                <Link href="/gallery" className="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">
                  Gallery
                </Link>
              </div>
            </div>
          </div>
        </div>
      </nav>

      <main className="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        <div className="px-4 py-6 sm:px-0">
          <div className="flex justify-between items-center mb-6">
            <h2 className="text-3xl font-bold text-gray-900">Deal Finder</h2>
            <button
              onClick={scanForDeals}
              disabled={scanning}
              className="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:opacity-50"
            >
              {scanning ? 'Scanning...' : 'Scan for Deals'}
            </button>
          </div>

          {error && (
            <div className="mb-4 bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded">
              {error}
            </div>
          )}

          {successMessage && (
            <div className="mb-4 bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded">
              {successMessage}
            </div>
          )}

          <div className="mb-4 bg-blue-50 border border-blue-200 rounded-lg p-4">
            <h4 className="text-sm font-medium text-blue-900 mb-2">Deal Scanner</h4>
            <p className="text-sm text-blue-800">
              Scans Tradera and Cardmarket for underpriced English Riftbound singles.
              Compares against Cardmarket EN prices. Expected profit assumes 10% fees and typical shipping costs.
            </p>
          </div>

          {loading ? (
            <div className="text-center py-12">
              <div className="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-gray-900"></div>
              <p className="mt-2 text-gray-500">Loading deals...</p>
            </div>
          ) : deals.length === 0 ? (
            <div className="bg-white shadow overflow-hidden sm:rounded-lg p-6 text-center">
              <p className="text-gray-500">No deals found yet.</p>
              <p className="text-sm text-gray-400 mt-2">Click &quot;Scan for Deals&quot; to search for underpriced cards.</p>
            </div>
          ) : (
            <>
              {goodDeals.length > 0 && (
                <div className="mb-6">
                  <h3 className="text-lg font-semibold text-gray-900 mb-3">Good Deals ({goodDeals.length})</h3>
                  <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    {goodDeals.map((deal) => (
                      <div key={deal.id} className="bg-white rounded-lg shadow-sm overflow-hidden border-2 border-green-200">
                        {deal.imageUrl && (
                          <div className="aspect-video bg-gray-100 relative">
                            <img
                              src={deal.imageUrl}
                              alt={deal.title}
                              className="absolute inset-0 w-full h-full object-contain"
                            />
                          </div>
                        )}
                        <div className="p-4">
                          <h4 className="text-sm font-medium text-gray-900 line-clamp-2 mb-2">{deal.title}</h4>
                          {deal.detectedCardName && (
                            <div className="text-xs text-gray-600 mb-2">
                              Detected: <span className="font-semibold">{deal.detectedCardName}</span>
                              {deal.confidence && ` (${Math.round(deal.confidence * 100)}%)`}
                            </div>
                          )}
                          <div className="space-y-1 text-xs">
                            <div className="flex justify-between">
                              <span className="text-gray-500">Buy price:</span>
                              <span className="font-medium">{deal.buyPriceSek.toFixed(2)} SEK</span>
                            </div>
                            <div className="flex justify-between">
                              <span className="text-gray-500">Shipping est:</span>
                              <span>{deal.shippingEstimateSek.toFixed(2)} SEK</span>
                            </div>
                            {deal.cardmarketEnLowSek && (
                              <div className="flex justify-between">
                                <span className="text-gray-500">CM EN Low:</span>
                                <span>{deal.cardmarketEnLowSek.toFixed(2)} SEK</span>
                              </div>
                            )}
                            {deal.expectedProfitSek && (
                              <div className="flex justify-between font-semibold text-green-700 border-t pt-1">
                                <span>Expected profit:</span>
                                <span>{deal.expectedProfitSek.toFixed(2)} SEK</span>
                              </div>
                            )}
                          </div>
                          <a
                            href={deal.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            className="mt-3 block w-full text-center px-3 py-2 border border-indigo-600 text-sm font-medium rounded-md text-indigo-600 hover:bg-indigo-50"
                          >
                            View on {deal.source}
                          </a>
                          {deal.detectedCardId && (
                            <button
                              onClick={() => importDeal(deal.id)}
                              disabled={importingDealId === deal.id}
                              className="mt-2 block w-full text-center px-3 py-2 border border-green-600 text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700 disabled:opacity-50"
                            >
                              {importingDealId === deal.id ? 'Importing...' : 'Import as Purchase'}
                            </button>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              <div>
                <h3 className="text-lg font-semibold text-gray-900 mb-3">All Results ({deals.length})</h3>
                <div className="bg-white shadow overflow-hidden sm:rounded-lg">
                  <table className="min-w-full divide-y divide-gray-200">
                    <thead className="bg-gray-50">
                      <tr>
                        <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Listing</th>
                        <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Detected Card</th>
                        <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Buy Price</th>
                        <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">CM EN Low</th>
                        <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Profit Est</th>
                        <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Scanned</th>
                      </tr>
                    </thead>
                    <tbody className="bg-white divide-y divide-gray-200">
                      {deals.map((deal) => (
                        <tr key={deal.id} className={!deal.languageFilterPass ? 'bg-gray-50' : ''}>
                          <td className="px-6 py-4">
                            <div className="text-sm font-medium text-gray-900 line-clamp-2">
                              <a href={deal.url} target="_blank" rel="noopener noreferrer" className="text-indigo-600 hover:text-indigo-500">
                                {deal.title}
                              </a>
                            </div>
                            <div className="text-sm text-gray-500">{deal.source}</div>
                          </td>
                          <td className="px-6 py-4">
                            {deal.detectedCardName ? (
                              <div>
                                <div className="text-sm text-gray-900">{deal.detectedCardName}</div>
                                <div className="text-xs text-gray-500">
                                  {deal.detectedCardCode} • {deal.confidence ? `${Math.round(deal.confidence * 100)}%` : '?'}
                                </div>
                              </div>
                            ) : (
                              <span className="text-sm text-gray-400">Not matched</span>
                            )}
                          </td>
                          <td className="px-6 py-4 text-right text-sm text-gray-900">{deal.buyPriceSek.toFixed(2)}</td>
                          <td className="px-6 py-4 text-right text-sm text-gray-900">
                            {deal.cardmarketEnLowSek ? deal.cardmarketEnLowSek.toFixed(2) : '—'}
                          </td>
                          <td className="px-6 py-4 text-right text-sm">
                            {deal.expectedProfitSek !== undefined ? (
                              <span className={deal.expectedProfitSek > 20 ? 'font-semibold text-green-700' : deal.expectedProfitSek > 0 ? 'text-green-600' : 'text-gray-500'}>
                                {deal.expectedProfitSek.toFixed(2)}
                              </span>
                            ) : (
                              <span className="text-gray-400">—</span>
                            )}
                          </td>
                          <td className="px-6 py-4 text-right text-sm text-gray-500">
                            {new Date(deal.scannedAt).toLocaleTimeString()}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            </>
          )}
        </div>
      </main>
    </div>
  );
}
